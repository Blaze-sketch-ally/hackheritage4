SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
FRONTEND_URL=http://localhost:3000
# Optional: extra CORS-allowed origins (comma-separated), e.g. a preview
# deployment domain. Leave empty in single-environment setups.
ADDITIONAL_CORS_ORIGINS=

# AI subsystem (backend/app/ai/) -- server-only, never expose to the
# frontend. Required for GET /api/v1/ai/health to report "configured".
GROQ_API_KEY=your_groq_api_key_here
# Optional overrides -- sensible defaults are centralized in
# backend/app/ai/config.py; uncomment only to change them.
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_TIMEOUT_SECONDS=30
# GROQ_MAX_RETRIES=2

# Optional: YouTube Data API v3 (external video-learning recommendations,
# Phase 4.7). Course/learning recommendations work with zero
# configuration here (internal catalog only) -- set this to also
# surface real YouTube videos for a student's top skill gaps. API-key
# auth only (no OAuth) -- see:
# https://developers.google.com/youtube/v3/getting-started
YOUTUBE_API_KEY=
YOUTUBE_TIMEOUT_SECONDS=8
# Optional overrides -- sensible defaults are centralized in
# backend/app/ai/config.py; uncomment only to change them.
# YOUTUBE_MAX_RESULTS_PER_SKILL=5
# YOUTUBE_CACHE_TTL_SECONDS=21600
